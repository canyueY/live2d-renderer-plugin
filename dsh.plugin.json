{
  "id": "dsh-murasame-pet",
  "version": "0.2.1",
  "main": "./lib/index.js",
  "description": "肥鱼身体组件：DSH 把整个 Murasame 工程当作身体，控制启动、说话、表情、显示与 B 站观察。",
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "entry": {
    "name": "dsh-murasame-pet",
    "inject": ["tools"]
  },
  "contributes": {
    "tools": [
      "pet_start",
      "pet_stop",
      "pet_status",
      "pet_set_visibility",
      "pet_set_scale",
      "body_start",
      "body_stop",
      "body_status",
      "body_say",
      "body_emote",
      "body_video",
      "body_music",
      "body_weather",
      "body_memory",
      "body_screen"
    ],
    "skills": []
  },
  "client": {
    "main": "./lib/client.js",
    "platform": "web"
  },
  "name": "肥鱼 Live2D 模型渲染插件"
}
