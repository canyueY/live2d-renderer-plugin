{
  "name": "dsh-murasame-pet",
  "version": "0.2.1",
  "type": "module",
  "description": "肥鱼身体组件：DSH 把整个 Murasame 工程当作身体，控制启动、说话、表情、显示与 B 站观察。",
  "license": "AGPL-3.0-or-later",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "main": "./lib/client.js"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "homepage": "https://github.com/canyueY/live2d-renderer-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canyueY/live2d-renderer-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/canyueY/live2d-renderer-plugin/issues"
  }
}
