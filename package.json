{
  "name": "dsh-murasame-pet",
  "version": "0.1.0",
  "type": "module",
  "description": "肥鱼 Live2D 模型渲染插件：把 MurasamePet Lite 绑定进 DSH，控制启动、显示模式与文字比例。",
  "license": "AGPL-3.0-or-later",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "main": "./lib/client.js"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "homepage": "https://github.com/canyueY/live2d-renderer-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canyueY/live2d-renderer-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/canyueY/live2d-renderer-plugin/issues"
  }
}
